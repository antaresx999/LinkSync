# LinkSync-Server – Einstellungen
# Kopieren nach ".env" und anpassen:  cp .env.example .env

# Nur für Variante B (mit eingebautem Caddy): Domain, unter der der Server erreichbar ist.
# Der DNS-Eintrag (A/AAAA) muss auf deinen Server zeigen. Caddy holt das HTTPS-Zertifikat automatisch.
DOMAIN=sync.example.com

# Neue Konten erlauben?
ALLOW_NEW_ACCOUNTS=true
# Höchstzahl Konten auf dem Server (0 = unbegrenzt)
MAX_ACCOUNTS=0
# Höchstzahl Lesezeichen und Ordner pro Konto
MAX_RECORDS_PER_ACCOUNT=50000
# Anfragen pro Minute und IP-Adresse (0 = unbegrenzt)
RATE_LIMIT_PER_MINUTE=120
# Neue Konten pro Stunde und IP-Adresse (0 = unbegrenzt)
NEW_ACCOUNTS_PER_HOUR=3
# Konten löschen, die so viele Tage nicht benutzt wurden (0 = nie). In der Datenschutzerklärung erwähnen!
DELETE_INACTIVE_AFTER_DAYS=0
# Hinweis, den die Erweiterung anzeigen kann (z. B. Wartung)
SERVER_MESSAGE=
