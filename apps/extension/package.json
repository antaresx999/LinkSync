{
  "name": "@linksync/extension",
  "version": "0.1.0",
  "private": true,
  "description": "LinkSync Browser-Erweiterung",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "test": "vitest run",
    "typecheck": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "e2e:firefox": "tsx e2e/firefox.e2e.ts",
    "try:firefox": "wxt build -b firefox --mv3 && web-ext run"
  },
  "dependencies": {
    "@linksync/core": "workspace:*",
    "idb-keyval": "^6.3.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7",
    "@wxt-dev/module-svelte": "^2.0.5",
    "puppeteer-core": "^25.16.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
